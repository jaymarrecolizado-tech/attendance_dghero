# All Father - Multi-Event Attendance Platform
# Copy this file to .env and update with your actual values

# Application
APP_URL=https://your-domain.com
APP_DEBUG=false
TZ=Asia/Manila

# Database Configuration
DB_HOST=localhost
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_database_password

# Database Auto-Migration (set to false in production after initial setup)
DB_AUTO_MIGRATE=false

# Rate Limiter (file or redis)
RATE_LIMITER_DRIVER=file

# SMTP Email Configuration
MAIL_MODE=smtp
SMTP_HOST=smtp.your-domain.com
SMTP_PORT=465
SMTP_USER=your_email@your-domain.com
SMTP_PASS=your_email_password
SMTP_SECURE=ssl
SMTP_FROM=your_email@your-domain.com

# Content Security Policy (set to true for stricter security)
CSP_STRICT=false

# Session
SESSION_COOKIE_SECURE=true

